# ──────────────────────────────────────────────────────────────────────────────
# Database — MySQL (Oracle Cloud HeatWave or local MySQL)
# ──────────────────────────────────────────────────────────────────────────────
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
#
# Local development:
#   DATABASE_URL=mysql+pymysql://root:password@localhost:3306/cv_enhancer
#
# OCI MySQL HeatWave (Always Free):
#   DATABASE_URL=mysql+pymysql://admin:password@<oci-endpoint>:3306/cv_enhancer
#
DATABASE_URL=mysql+pymysql://rabindra:ravindra@localhost:3306/cv_enhancer

# ──────────────────────────────────────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production

# ──────────────────────────────────────────────────────────────────────────────
# Environment
# ──────────────────────────────────────────────────────────────────────────────
ENV=development

# ──────────────────────────────────────────────────────────────────────────────
# AI Enhancement (Groq - free tier, get key at https://console.groq.com)
# ──────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here

# AI Model (optional)
AI_MODEL_TYPE=openai
AI_API_KEY=
